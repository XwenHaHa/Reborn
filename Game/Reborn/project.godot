; Reborn / 正式 Godot 工程配置
;
; 引擎：Godot 4.7.2（GDScript）
; 单位：米（m）。Docs/Parameters.md 是厘米，代码中已 ÷100。
; 依据：Docs/TechnicalDesign.md v0.2
;
; 本文件为纯文本，可直接由 agent 编写与 diff，无需编辑器。

config_version=5

[application]

config/name="Reborn"
config/description="轮生 Reborn — Windows 单机双物种硬核生存切片。T002 最小工程。"
run/main_scene="res://scenes/core/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

; 世界时间、资源、区域账本的统一入口（T014/T034 扩充）
WorldDirector="*res://autoload/world_director.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
