[layer_names]

3d_physics/layer_1="world_static"
3d_physics/layer_2="animal"
3d_physics/layer_3="interactable"
3d_physics/layer_4="safe_spot"

[physics]

3d/default_gravity=9.8

[rendering]

; T600 Laptop 4GB。先按 forward_plus 建立；P1 实测帧率后若不达标再退 mobile。
; 起测关闭不必要特效。
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.15, 0.17, 0.2, 1)
