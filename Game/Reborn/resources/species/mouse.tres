[gd_resource type="Resource" script_class="SpeciesConfig" load_steps=3 format=3]

; 鼠的起测配置。数值来源：Docs/Parameters.md（厘米 → 米，÷100）。
; 与猫的关键差异：更小（0.06/0.09）、更慢、MaxStepHeight 3 cm、禁止跳跃、可用鼠洞、吃种子。

[ext_resource type="Script" path="res://scripts/data/species_config.gd" id="1_cfg"]
[ext_resource type="Script" path="res://scripts/ai/mouse_ai.gd" id="2_ai"]

[resource]
script = ExtResource("1_cfg")
species_id = &"Mouse"
capsule_radius = 0.06
capsule_half_height = 0.09
crouch_half_height = 0.06
walk_speed = 1.1
sprint_speed = 3.0
crouch_speed = 0.65
max_step_height = 0.03
jump_velocity = 0.0
max_acceleration = 16.0
camera_offset_z = 0.03
fov = 90.0
vision_range = 6.5
vision_half_angle_deg = 75.0
hearing_range = 10.0
; 噪声（T020）：响度来自 Parameters.md 第 73 行（潜伏/行走/奔跑 = 0.2/0.5/1.0）；
; 脚步节奏 0.5 s 是 T020 新增值（Parameters 只给了响度），其他档位按速度反比缩放。
noise_loudness_crouch = 0.2
noise_loudness_walk = 0.5
noise_loudness_sprint = 1.0
footstep_interval_base = 0.5
; 生存容量（T014）：Parameters.md 第 15 行「初始 Health/Hunger/Thirst/Stamina 100/100/100/100」
max_health = 100.0
max_hunger = 100.0
max_thirst = 100.0
max_stamina = 100.0
; 消耗与伤害（T015）：Parameters.md 第 65 行标"共同"，两物种同值
sprint_min_stamina = 5.0
low_stat_threshold = 25.0
starvation_damage_per_sec = 1.0
dehydration_damage_per_sec = 1.0
fall_safe_vertical_speed = 7.0
fall_damage_scale = 10.0
hunger_loss_per_sec = 0.1
thirst_loss_per_sec = 0.08
sprint_stamina_per_sec = 35.0
stamina_regen_per_sec = 25.0
regen_delay = 0.7
interaction_range = 0.45
allowed_food_types = Array[int]([1])
can_jump = false
can_pounce = false
can_use_mouse_tunnel = true
; 行为（T019）：鼠有觅食+警戒状态机；猫留空（T023 再做）
ai_script = ExtResource("2_ai")
