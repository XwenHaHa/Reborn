[gd_resource type="Resource" script_class="SpeciesConfig" load_steps=4 format=3]

; 猫的起测配置。数值来源：Docs/Parameters.md（厘米 → 米，÷100）。
; 改数值请改这里，不要在系统代码里另写一份（见 Docs/Tasks/T008.md）。

[ext_resource type="Script" path="res://scripts/data/species_config.gd" id="1_cfg"]
[ext_resource type="Script" path="res://scripts/ai/cat_ai.gd" id="2_ai"]
[ext_resource type="PackedScene" path="res://assets/characters/cat/sm_cat_002.glb" id="3_vis"]

[resource]
script = ExtResource("1_cfg")
species_id = &"Cat"
; ART02：真实视觉模型（静态网格，无骨骼；骨骼/动画资产属 P6 阶段门）。
; 网格只做视觉：碰撞、尺寸契约仍由胶囊负责。
visual_scene = ExtResource("3_vis")
capsule_radius = 0.16
capsule_half_height = 0.24
crouch_half_height = 0.15
walk_speed = 1.8
sprint_speed = 4.5
crouch_speed = 0.9
max_step_height = 0.12
jump_velocity = 3.2
max_acceleration = 10.0
camera_offset_z = 0.1
fov = 90.0
vision_range = 9.0
vision_half_angle_deg = 60.0
; 生存容量（T014）：Parameters.md 第 15 行「初始 Health/Hunger/Thirst/Stamina 100/100/100/100」
max_health = 100.0
max_hunger = 100.0
max_thirst = 100.0
max_stamina = 100.0
; 消耗与伤害（T015）：Parameters.md 第 65 行标"共同"，两物种同值
sprint_min_stamina = 5.0
low_stat_threshold = 25.0
starvation_damage_per_sec = 1.0
dehydration_damage_per_sec = 1.0
fall_safe_vertical_speed = 7.0
fall_damage_scale = 10.0
hearing_range = 12.0
; 噪声（T020）：响度来自 Parameters.md 第 73 行（潜伏/行走/奔跑 = 0.2/0.5/1.0）；
; 脚步节奏 0.5 s 是 T020 新增值（Parameters 只给了响度），其他档位按速度反比缩放。
noise_loudness_crouch = 0.2
noise_loudness_walk = 0.5
noise_loudness_sprint = 1.0
footstep_interval_base = 0.5
hunger_loss_per_sec = 0.08
thirst_loss_per_sec = 0.06
sprint_stamina_per_sec = 15.0
stamina_regen_per_sec = 18.0
regen_delay = 1.0
interaction_range = 1.0
allowed_food_types = Array[int]([0])
can_jump = true
can_pounce = true
can_use_mouse_tunnel = false
; 扑击与捕获（T021）：Parameters.md 第 67 行（最大水平距离 140 cm / 持续 0.25 s / 体力 25 / 恢复 0.6 s）
; 捕获食物失效 300 s 来自第 77 行；营养值 35.0 沿用 ResourcePoint 默认值。
pounce_max_distance = 1.4
pounce_duration = 0.25
pounce_stamina_cost = 25.0
pounce_recovery = 0.6
capture_food_expire = 300.0
; 攻击（T025）：Parameters.md 第 69 行（预警 0.45 s / 伤害 35 / 攻击恢复 1.2 s / AttackRange 65 cm ÷100）；
; 朝向半角 60° 是 T025 新增的实现默认值（Parameters 无对应行，待负责人并入正式值）。
can_attack = true
attack_damage = 35.0
attack_telegraph = 0.45
attack_recovery = 1.2
attack_range = 0.65
attack_facing_half_angle_deg = 60.0
; 行为（T023）：猫 NPC = 巡游 / 发现 / 警戒 / 接近；Alert 0.4 s 与 AttackRange 0.65 见 Docs/Parameters.md 第 69 行
ai_script = ExtResource("2_ai")
