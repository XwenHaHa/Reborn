[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.16
height = 0.48

[sub_resource type="CapsuleMesh" id="CapsuleMesh_body"]
radius = 0.16
height = 0.48

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_body"]
